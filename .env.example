# Copy this file to .env and adjust as needed.

# Required. A Postgres connection string. A free one from neon.tech works
# great - create a project there, copy its connection string, paste it here.
# Local Postgres works too, e.g. postgres://postgres:password@localhost:5432/nflsimi
DATABASE_URL=

# Port the web server listens on.
PORT=3000

# There's no site-wide admin password anymore - each group sets its own
# admin password when it's created (see the "Create a group" screen).
